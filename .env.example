POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bizstruct
POSTGRES_HOST=db
POSTGRES_PORT=5432

DEBUG=false
ALLOWED_ORIGINS=["*"]

# Shared secret bizstruct-ml sends as `x-api-key` to the internal endpoints.
INTERNAL_API_KEY=change-me-in-production

# A row RUNNING longer than this (seconds) becomes ERROR (stuck_timeout) the next time its project is read.
STUCK_TIMEOUT_SECONDS=1800

# Azure Service Bus: one message per ready row. Empty = enqueueing is a logged no-op.
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=generation-tasks

# Azure Web PubSub: a StageEvent after every applied transition. Empty = no events.
AZURE_WEB_PUBSUB_CONNECTION_STRING=
AZURE_WEB_PUBSUB_HUB=bizstruct
